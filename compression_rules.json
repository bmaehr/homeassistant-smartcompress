        "last_seen": "last",
        "last_time_reachable": "last",
        "uptime": "max",
        "linkquality": "ignore",
        "battery": { "strategy": "tolerance", "tolerance": 1.0 },
        "voltage": { "strategy": "tolerance", "tolerance": 15.0 },
